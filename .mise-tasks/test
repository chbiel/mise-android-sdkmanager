#!/usr/bin/env bash
#MISE description="Run backend plugin tests"
set -euo pipefail

PLUGIN="android-sdkmanager"
PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PASS=0
FAIL=0

pass() { echo "✓ $1"; PASS=$((PASS + 1)); }
fail() { echo "✗ $1"; FAIL=$((FAIL + 1)); }

# ── Isolated mise environment ─────────────────────────────────────────────────
# All mise operations run inside a temp dir so the global tool store,
# cache, and config are never touched.
# Resolve the existing Lua dependency before isolating mise's tool store.
if command -v lua >/dev/null 2>&1; then
    SDK_TEST_LUA=$(command -v lua)
else
    SDK_TEST_LUA=$(mise exec lua -- sh -c 'command -v lua')
fi
export SDK_TEST_LUA
MISE_TEST_DIR=$(mktemp -d "$PLUGIN_DIR/.test.XXXXXXXX")
trap 'rm -rf -- "$MISE_TEST_DIR"' EXIT
mkdir "$MISE_TEST_DIR/scratch"
export TMPDIR="$MISE_TEST_DIR/scratch"
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-Djava.io.tmpdir=$TMPDIR"
export MISE_DATA_DIR="$MISE_TEST_DIR/unit-data"
export MISE_CACHE_DIR="$MISE_TEST_DIR/cache"
export MISE_CONFIG_DIR="$MISE_TEST_DIR/config"
export MISE_STATE_DIR="$MISE_TEST_DIR/state"
export MISE_GLOBAL_CONFIG_FILE="$MISE_TEST_DIR/global.toml"
export MISE_SYSTEM_CONFIG_FILE="$MISE_TEST_DIR/system.toml"
export MISE_TRUSTED_CONFIG_PATHS="$MISE_TEST_DIR"
export MISE_OVERRIDE_CONFIG_FILENAMES=test.mise.toml
export MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES=test.tool-versions
touch "$MISE_GLOBAL_CONFIG_FILE" "$MISE_SYSTEM_CONFIG_FILE"
"$SDK_TEST_LUA" "$PLUGIN_DIR/tests/regression.lua" "$PLUGIN_DIR" "$MISE_TEST_DIR"
bash "$PLUGIN_DIR/tests/locking.sh" "$PLUGIN_DIR" "$MISE_TEST_DIR"
if [[ "${1:-}" == "--unit" ]]; then
    exit 0
fi
bash "$PLUGIN_DIR/tests/runtime.sh" "$PLUGIN_DIR" "$MISE_TEST_DIR"
if [[ "${1:-}" == "--runtime" ]]; then
    exit 0
fi
export MISE_DATA_DIR="$MISE_TEST_DIR/data"
export MISE_CACHE_DIR="$MISE_TEST_DIR/cache"
export MISE_CONFIG_DIR="$MISE_TEST_DIR/config"
export MISE_STATE_DIR="$MISE_TEST_DIR/state"
export MISE_IGNORED_CONFIG_PATHS="${HOME}/.config/mise/config.toml:${HOME}/.config/mise.toml"
export MISE_CONFIG_FILE="$MISE_TEST_DIR/test.mise.toml"

cd "$MISE_TEST_DIR"

# ── 1. Plugin registration ────────────────────────────────────────────────────
echo "=== Plugin registration ==="
mise plugin link --force "$PLUGIN" "$PLUGIN_DIR"
pass "plugin link"
mise cache clear 2>/dev/null

# ── 2. Install dependencies (android-sdk + java) via mise ────────────────────
echo ""
echo "=== Installing test dependencies ==="

cat > "$MISE_CONFIG_FILE" << 'EOF'
[tool_alias.android-sdk]
backend = "vfox:mise-plugins/vfox-android-sdk"
[tools]
android-sdk = "latest"
java = "temurin-17"
[settings]
experimental = true
EOF
if [[ "${1:-}" == "--sdk-stress" ]]; then
    # Match the consuming project's command-line tooling, without its hooks or credentials.
    cat > "$MISE_CONFIG_FILE" << 'EOF'
[tool_alias.android-sdk]
backend = "vfox:mise-plugins/vfox-android-sdk"
[tools]
android-sdk = "20.0"
java = "temurin-21"
[settings]
experimental = true
EOF
fi

echo "Installing vfox:mise-plugins/vfox-android-sdk and java via mise..."
mise install --yes
pass "android-sdk + java installed"

eval "$(mise env --shell bash)"
pass "android-sdk env loaded (ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-<unset>})"
dependency_root=$(mise where android-sdk)
export SDK_TEST_DEPENDENCY_ROOT="$dependency_root"

if [[ "${1:-}" == "--sdk-stress" ]]; then
    sdk_tools=(
        "${PLUGIN}:build-tools@36.0.0"
        "${PLUGIN}:platforms@android-36"
        "${PLUGIN}:ndk@28.2.13676358"
        "${PLUGIN}:cmake@3.22.1"
    )
    mise install --jobs 4 "${sdk_tools[@]}"
    mise exec "${sdk_tools[@]}" -- sh -eu -c '
        test "$ANDROID_HOME" = "$ANDROID_SDK_ROOT"
        test "$ANDROID_HOME" = "$SDK_TEST_DEPENDENCY_ROOT"
        test -f "$ANDROID_HOME/build-tools/36.0.0/aapt"
        test -f "$ANDROID_HOME/platforms/android-36/android.jar"
        test -f "$ANDROID_HOME/ndk/28.2.13676358/ndk-build"
        test -f "$ANDROID_HOME/cmake/3.22.1/bin/cmake"
        test ! -e "$ANDROID_HOME/.mise-install-lock"
        test ! -L "$ANDROID_HOME/cmdline-tools"
        test ! -e "$ANDROID_HOME/.mise-cmdline-tools"
    '
    pass "cold parallel SDK installs and warm activation"
    mkdir archive
    printf 'SDK root regression\n' > archive/expected.txt
    mise exec -- jar --create --file minimal.apk --no-manifest -C archive expected.txt
    mise exec "${sdk_tools[@]}" -- apkanalyzer files list minimal.apk > apkanalyzer-files.log
    grep -q '/expected.txt' apkanalyzer-files.log
    pass "real apkanalyzer 20.0 lists archive contents using dependency build-tools"
    exit 0
fi

# ── 3. ls-remote: single-version tools ───────────────────────────────────────
# emulator and platform-tools expose exactly one version in sdkmanager. ls-remote
# resolves that to the concrete version number (not the "latest" alias) so mise
# records a real version and can detect updates.
echo ""
echo "=== ls-remote (single-version tools) ==="
for tool in emulator platform-tools; do
    versions=$(mise ls-remote "${PLUGIN}:${tool}" 2>/dev/null || echo "")
    if echo "$versions" | grep -qE '^[0-9]+(\.[0-9]+)*$'; then
        pass "ls-remote ${tool} returns a concrete version"
    else
        fail "ls-remote ${tool} — expected a concrete version, got: ${versions:-<empty>}"
    fi
done

# ── 4. ls-remote: versioned tools ────────────────────────────────────────────
echo ""
echo "=== ls-remote (versioned tools) ==="
for tool in build-tools platforms ndk cmake; do
    versions=$(mise ls-remote "${PLUGIN}:${tool}" 2>/dev/null || echo "")
    if [[ -n "$versions" ]]; then
        pass "ls-remote ${tool} returns versions"
    else
        fail "ls-remote ${tool} — no versions returned"
    fi
done

si_versions=$(mise ls-remote "${PLUGIN}:system-images" 2>/dev/null || echo "")
if echo "$si_versions" | grep -q "^android-"; then
    pass "ls-remote system-images returns android-NN versions"
else
    fail "ls-remote system-images — expected android-NN versions, got: ${si_versions:-<empty>}"
fi

# ── 5. install + exec-env ────────────────────────────────────────────────────
echo ""
echo "=== install + exec-env ==="
if mise install "${PLUGIN}:platform-tools@latest"; then
    pass "install platform-tools@latest"

    if mise exec "${PLUGIN}:platform-tools@latest" -- adb version &>/dev/null; then
        pass "exec-env: adb on PATH after install"
    else
        fail "exec-env: adb not found on PATH after install"
    fi

    if mise exec "${PLUGIN}:platform-tools@latest" -- sh -eu -c '
        test "$ANDROID_HOME" = "$ANDROID_SDK_ROOT"
        test -d "$ANDROID_HOME/cmdline-tools"
        sdkmanager=$(find -L "$ANDROID_HOME/cmdline-tools" -type f -path "*/bin/sdkmanager" -print -quit)
        test -n "$sdkmanager"
        installed=$("$sdkmanager" --sdk_root="$ANDROID_HOME" --list_installed)
        printf "%s\n" "$installed" | grep -q "platform-tools"
    '; then
        pass "exec-env: command-line tools inside SDK root can list installed packages"
    else
        fail "exec-env: command-line tools missing or cannot list dependency-root packages"
    fi

else
    fail "install platform-tools@latest"
fi

# ── 6. install emulator (modern Android CLI) ─────────────────────────────────
# Starting with cmdline-tools 22, `emulator` can no longer be installed via
# sdkmanager and requires `android sdk install`. Verify the plugin installs it
# using the preferred android CLI and puts it on PATH.
echo ""
echo "=== install emulator (modern Android CLI) ==="
if mise install "${PLUGIN}:emulator@latest"; then
    pass "install emulator@latest"

    if mise exec "${PLUGIN}:emulator@latest" -- emulator -version &>/dev/null; then
        pass "exec-env: emulator on PATH after install"
    else
        fail "exec-env: emulator not found on PATH after install"
    fi
else
    fail "install emulator@latest"
fi

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
echo "Results: ${PASS} passed, ${FAIL} failed"
[[ $FAIL -eq 0 ]]
